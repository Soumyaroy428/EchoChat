  "cards": [
    {
      "dot": "cyan",
      "title": "Identity & Relationships",
      "items": [
        "User is the central account entity; email is strictly unique for login and verification.",
        "NewContact records reference the owner account and optionally linked contact user profiles.",
        "Status stories and group creations maintain direct foreign-key associations to User._id."
      ]
    },
    {
      "dot": "emerald",
      "title": "Chat Delivery & Media",
      "items": [
        "MessageHistory stores direct and channel messages with status progression (sent -> delivered -> read).",
        "Supports mixed payloads: plain text, rich audio, image, attachment URLs, and E2EE metadata.",
        "Optional groupId links messages to multi-member Group rooms with admin hierarchies."
      ]
    },
    {
      "dot": "amber",
      "title": "Security & Profile Resolution",
      "items": [
        "Otp records link directly to User.email via foreign-key relationship, expiring after 5 minutes.",
        "Upon OTP verification, the server authenticates the session and returns the full User profile.",
        "Frontend persists the verified session token and immediately displays the user profile dashboard."
      ]
    }
  ]
