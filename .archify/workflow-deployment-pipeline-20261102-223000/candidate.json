  "cards": [
    {
      "dot": "emerald",
      "title": "Decoupled Deployment Architecture",
      "items": [
        "Frontend Next.js client deploys serverlessly to Vercel global edge network.",
        "Backend Express server with Socket.IO runs as a persistent container on Render.",
        "Parallel webhooks deploy both microservices concurrently on every push to master."
      ]
    },
    {
      "dot": "cyan",
      "title": "Environment Secrets & Network Routing",
      "items": [
        "Vercel holds Gmail SMTP credentials and dispatches verification emails on open port 465.",
        "Render connects securely to MongoDB Atlas cluster and verifies JWT token signatures.",
        "Browser clients connect seamlessly across REST API routes and persistent WebSocket channels."
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery & Health Verification",
      "items": [
        "Build failures immediately halt deployments before edge or container activation.",
        "End-to-end synthetic health checks confirm REST response codes and socket connection liveness.",
        "Instant Git revert or platform dashboard rollback restores the previous verified image."
      ]
    }
  ]
